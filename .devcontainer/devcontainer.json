{
  "name": "ATD 2026 · Completion Theater Hackathon",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12", "installTools": false },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest",
      "installDirectlyFromGitHubRelease": false
    }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "containerEnv": { "NPM_CONFIG_PREFIX": "/home/node/.local" },
  "remoteEnv": { "PATH": "/home/node/.local/bin:${containerEnv:PATH}" },
  "forwardPorts": [8765, 3000, 5173, 8000],
  "portsAttributes": {
    "8765": { "label": "Session Seat Desk", "onAutoForward": "notify" },
    "3000": { "label": "Optional Node app", "onAutoForward": "notify" },
    "5173": { "label": "Optional Vite UI", "onAutoForward": "notify" },
    "8000": { "label": "Optional Python app", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "anthropic.claude-code", "openai.chatgpt", "yzhang.markdown-all-in-one"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.fontSize": 16,
        "terminal.integrated.fontSize": 16
      }
    },
    "codespaces": { "openFiles": ["docs/07-Codespaces-and-Judging.md", "docs/01-Starter-PRD.md"] }
  }
}
